

{%- capture class -%}{{ class }} icon icon-{{ icon | handle }} {%- endcapture -%}
{%- case icon -%}
  {%- when 'arrow-right' -%}
    <svg 
      width="{{ width | default: 18 }}"
      height="{{ height | default: 18 }}"
      class="{{ class | strip }}" 
      viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g id="SVGRepo_bgCarrier" stroke-width="0">
        </g>
        <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round" stroke="#CCCCCC" stroke-width="0.048"></g>
            <g id="SVGRepo_iconCarrier"> 
            <path d="M6 12H18M18 12L13 7M18 12L13 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> 
        </g>
    </svg>

    {% endcase %}
