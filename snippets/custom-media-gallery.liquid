 
<div class="product-gallery_main">
    <div class="swiper-wrapper">
        {%- for media in product.media -%}
            <div class="swiper-slide">
                   {% render 'smart-image',
                        image: media,
                        width:2000,
                        class: 'story_image',
                        loading: 'lazy',
                        widths: '600, 800, 1000, 1200, 1600, 2000',
                        sizes: '(max-width: 749px) 100vw, 58vw'
                    %}
            </div>

        {% endfor %}
    </div>
        <div class="custom-product_navigation">
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>
        <div class="product-gallery__counter">
            <span class="product-gallery__current">1</span>
            <span>/</span>
            <span class="product-gallery__total">6</span>
        </div>
</div>

<div class="product-gallery_thumbs">
    <div class="swiper-wrapper">
          {%- for media in product.media -%}
            <div class="swiper-slide product_gallery_thumbs_item">
                   {% render 'smart-image',
                        image: media,
                        width:400,
                        class: 'story_image',
                        loading: 'lazy',
                        widths: '100, 150, 200, 250, 300, 350,400'
                    %}
            </div>

        {% endfor %}
    </div>
</div>

