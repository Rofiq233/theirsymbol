{{ 'hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .hero-{{ section.id }} {
    --hero-desktop-height: {{ section.settings.desktop_height }}px;
    --hero-mobile-height: {{ section.settings.mobile_height }}px;
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}


<section
  class="hero hero-{{ section.id }} section-{{ section.id }}-padding{% if section.settings.enable_overlay %} hero--overlay{% endif %} gradient color-{{ section.settings.section_color_scheme }} section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
>

  <div class="hero__media">

      {%- render 'responsive-picture', desktop_image: section.settings.desktop_image
      mobile_image:section.settings.mobile_image,
      loading: 'eager',
                  fetchpriority: 'high',
                  sizes: '100vw',
                  class: 'banner__image',
                  placeholder:"hero-apparel-2"
      
      -%}

  </div>


  {% if section.settings.enable_overlay %}
    <div class="hero__overlay-background"></div>
  {% endif %}


  <div class="hero__content-wrapper">

    <div class="hero__content {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

      {% if section.settings.heading != blank %}

        <{{ section.settings.heading_size }}
          class="hero__heading {{ section.settings.heading_size }}"
        >
          {{ section.settings.heading }}
        </{{ section.settings.heading_size }}>

      {% endif %}


      {% if section.settings.description != blank %}

        <div class="hero__description {{ section.settings.text_style }}">
          {{ section.settings.description }}
        </div>

      {% endif %}


      {% if section.settings.btn != blank %}

        <a
          href="{{ section.settings.url | default: '#' }}"
          class="hero__button button button--{{ section.settings.button_style }}"
        >
          <span class="hero__button-text">
            {{ section.settings.btn }}
          </span>  

           <span class="hero__button-icon icon">
                        {% render 'icons' icon:'arrow-right', width: '25', height: '25' %}
                    </span>
        </a>

      {% endif %}


      {% if section.blocks.size > 0 %}

        <div class="hero__features">

          {% for block in section.blocks %}

            <div
              class="hero__feature"
              {{ block.shopify_attributes }}
            >

                <div class="hero__feature-icon">

                    {% render 'smart-image',
                        image: block.settings.icon,
                        class: 'list__image',
                        width:40,
                        loading: 'lazy',
                        widths: '20,25,30,40',
                        sizes: '40'
                    %}

                </div>


              <div class="hero__feature-content">

                {% if block.settings.title != blank %}

                  <div class="hero__feature-title">
                    {{ block.settings.title }}
                  </div>

                {% endif %}


                {% if block.settings.text != blank %}

                  <div class="hero__feature-text">
                    {{ block.settings.text }}
                  </div>

                {% endif %}

              </div>

            </div>

          {% endfor %}

        </div>

      {% endif %}

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",

  "settings": [

    {
      "type": "header",
      "content": "Images"
    },

    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },

    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },


    {
      "type": "header",
      "content": "Height"
    },

    {
      "type": "range",
      "id": "desktop_height",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Desktop height",
      "default": 600
    },

    {
      "type": "range",
      "id": "mobile_height",
      "min": 250,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Mobile height",
      "default": 500
    },


    {
      "type": "header",
      "content": "Overlay"
    },

    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable overlay",
      "default": true
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 35
    },


    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Symbol Has a Story."
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Meaningful jewelry inspired by real people and the moments that changed their lives.</p>"
    },


    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },


    {
      "type": "select",
      "id": "text_style",
      "options": [
        {
          "value": "body",
          "label": "t:sections.image-with-text.blocks.text.settings.text_style.options__1.label"
        },
        {
          "value": "subtitle",
          "label": "t:sections.image-with-text.blocks.text.settings.text_style.options__2.label"
        }
      ],
      "default": "body",
      "label": "t:sections.image-with-text.blocks.text.settings.text_style.label"
    },


    {
      "type": "header",
      "content": "Button"
    },

    {
      "type": "text",
      "id": "btn",
      "label": "Button text",
      "default": "Shop now"
    },

    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "primary-outline",
          "label": "Primary outline"
        }
      ],
      "default": "primary"
    },

    {
      "type": "url",
      "id": "url",
      "label": "Url"
    },


    {
      "type": "header",
      "content": "Padding"
    },

    {
      "type": "paragraph",
      "content": "Desktop"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Top",
      "default": 0
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },

    {
      "type": "paragraph",
      "content": "Mobile"
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },
       {
              "type": "color_scheme",
              "id": "section_color_scheme",
              "label": "Scheme"
            }
  ],


  "blocks": [

    {
      "type": "feature",
      "name": "Feature",

      "settings": [

        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Quality"
        },

        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Made with care"
        }

      ]
    }

  ],


  "max_blocks": 3,


  "presets": [

    {
      "name": "Hero",

      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Premium Quality",
            "text": "Made with care"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Real People",
            "text": "Verified Stories"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Free Shipping",
            "text": "On All Orders"
          }
        }
      ]
    }

  ]
}
{% endschema %}