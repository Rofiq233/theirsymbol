{{ 'sticky-product-bar.css' | asset_url | stylesheet_tag }}


{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign sticky_option = product.options_with_values.first -%}

<sticky-product-bar
  id="StickyProductBar-{{ section.id }}"
  class="sticky-product-bar"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-threshold="300"  
>
  <div class="sticky-product-bar__inner page-width">

    <div class="sticky-product-bar__product">

      <div class="sticky-product-bar__image">
        {% if product.featured_image %}
          {{
            product.featured_image
            | image_url: width: 160
            | image_tag:
              loading: 'lazy',
              widths: '80, 120, 160',
              sizes: '80px',
              class: 'sticky-product-bar__image-img',
              alt: product.featured_image.alt | default: product.title
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'sticky-product-bar__image-placeholder' }}
        {% endif %}
      </div>

      <div class="sticky-product-bar__product-info">

        <div class="sticky-product-bar__title">
          {{ product.title }}
        </div>

        <div
          class="sticky-product-bar__price"
          data-product-price
        >
          {{ current_variant.price | money }}
        </div>

      </div>

    </div>

    {% if sticky_option and sticky_option.values.size > 1 %}

      <div class="sticky-product-bar__variants">

        {% for option_value in sticky_option.values %}

          {%- assign option_variant = blank -%}

          {% for variant in product.variants %}
            {% if variant.option1 == option_value and variant.available %}
              {% assign option_variant = variant %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% if option_variant == blank %}
            {% for variant in product.variants %}
              {% if variant.option1 == option_value %}
                {% assign option_variant = variant %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if option_variant != blank %}

            {%- assign save_amount = 0 -%}

            {% if option_variant.compare_at_price > option_variant.price %}
              {% assign save_amount =
                option_variant.compare_at_price
                | minus: option_variant.price
              %}
            {% endif %}

            {%- assign is_selected = false -%}

            {% if current_variant.id == option_variant.id %}
              {% assign is_selected = true %}
            {% endif %}

            <label
              class="
                sticky-product-bar__variant
                {% if is_selected %}is-selected{% endif %}
                {% unless option_variant.available %}is-disabled{% endunless %}
              "
              data-variant-card
              data-variant-id="{{ option_variant.id }}"
              data-variant-price="{{ option_variant.price }}"
              data-variant-compare-price="{{ option_variant.compare_at_price | default: 0 }}"
              data-variant-save="{{ save_amount }}"
              data-variant-available="{{ option_variant.available }}"
            >

              <input
                type="radio"
                name="StickyVariant-{{ section.id }}"
                value="{{ option_variant.id }}"
                data-variant-input
                {% if is_selected %}checked{% endif %}
                {% unless option_variant.available %}disabled{% endunless %}
              >

              <span class="sticky-product-bar__radio">
                <span class="sticky-product-bar__radio-dot"></span>
              </span>


              <span class="sticky-product-bar__variant-content">

                <span class="sticky-product-bar__variant-name">
                  {{ option_value }}
                </span>

                <span class="sticky-product-bar__variant-price-row">

                  <span class="sticky-product-bar__variant-price">
                    {{ option_variant.price |  money_without_trailing_zeros }}
                  </span>

                </span>


                {% if save_amount > 0 %}
                  <span class="sticky-product-bar__variant-save">
                    Save {{ save_amount | money_without_trailing_zeros }}
                  </span>
                {% endif %}

              </span>

            </label>

          {% endif %}

        {% endfor %}

      </div>

    {% endif %}
    <div class="sticky-product-bar__action">

      <button
        type="button"
        class="sticky-product-bar__add"
        data-add-to-cart
        {% unless current_variant.available %}disabled{% endunless %}
      >

        <span class="sticky-product-bar__add-label">
          {% if current_variant.available %}
            Add to Cart
          {% else %}
            Sold Out
          {% endif %}
        </span>

        {% comment %} {% if current_variant.available %}
          <span class="sticky-product-bar__arrow">
            →
          </span>

          <span
            class="sticky-product-bar__add-price"
            data-add-price
          >
            {{ current_variant.price | money }}
          </span>
        {% endif %} {% endcomment %}

      </button>

    </div>

  </div>


  <!-- ========================================================
       VARIANT DATA FOR JS
       ======================================================== -->
  <script type="application/json" data-product-variants>
    [
      {% for variant in product.variants %}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
          "option1": {{ variant.option1 | json }},
          "option2": {{ variant.option2 | json }},
          "option3": {{ variant.option3 | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>

</sticky-product-bar>




<script
  src="{{ 'sticky-product-bar.js' | asset_url }}"
  defer
></script>


{% schema %}
{
  "name": "Sticky product bar",
  "tag": "section",
  "class": "section-sticky-product-bar",
  "settings": [],
  "presets": [
    {
      "name": "Sticky product bar"
    }
  ]
}
{% endschema %}