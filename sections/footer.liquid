{{ 'custom-footer.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top}}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<footer class="custom-footer gradient color-{{ section.settings.section_color_scheme }}">
  <div class="custom-footer__inner {{ section.settings.layout }}  section-{{ section.id }}-padding">

    <div class="custom-footer__top {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

      {% for block in section.blocks %}

        {% case block.type %}

          {% when 'details' %}

            <div class="custom-footer__details" {{ block.shopify_attributes }}>

              {% if block.settings.logo != blank %}
                <div class="custom-footer__logo">
                  {{
                    block.settings.logo
                    | image_url: width: 500
                    | image_tag:
                      loading: 'lazy',
                      widths: '150, 250, 350, 500',
                      class: 'custom-footer__logo-image'
                  }}
                </div>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="custom-footer__details-text">
                  {{ block.settings.text }}
                </div>
              {% endif %}

            </div>


          {% when 'menu' %}

            <div class="custom-footer__menu" {{ block.shopify_attributes }}>

              {% if block.settings.title != blank %}
                <h3 class="custom-footer__menu-title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.menu != blank %}
                <ul class="custom-footer__menu-list">

                  {% for link in block.settings.menu.links %}
                    <li class="custom-footer__menu-item">

                      <a
                        href="{{ link.url }}"
                        class="custom-footer__menu-link"
                      >
                        {{ link.title }}
                      </a>

                    </li>
                  {% endfor %}

                </ul>
              {% endif %}

            </div>

        {% endcase %}

      {% endfor %}

    </div>


    <div class="custom-footer__bottom {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

      <div class="custom-footer__copyright">
        {{ section.settings.copyright }}
      </div>

    </div>

  </div>
</footer>


{% schema %}
{
  "name": "Custom Footer",
  "tag": "section",
  "class": "custom-footer-section",

  "settings": [
    {
    "type": "select",
    "id": "layout",
    "label": "Layout",
    "options": [
        {
            "label": "Full width",
            "value": "full-width"
        },
        {
            "label": "Page width",
            "value": "page-width"
        }
    ]
    },
           {
              "type": "color_scheme",
              "id": "section_color_scheme",
              "label": "Scheme"
            },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "© 2026 Their Symbol. All rights reserved."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "paragraph",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "paragraph",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 36
    }

  ],

  "blocks": [
    {
      "type": "details",
      "name": "Details",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Meaningful jewelry inspired by real people and the moments that change their lives.</p>"
        }
      ]
    },

    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Custom Footer",

      "blocks": [
        {
          "type": "details"
        },
        {
          "type": "menu",
          "settings": {
            "title": "Shop"
          }
        },
        {
          "type": "menu",
          "settings": {
            "title": "About"
          }
        },
        {
          "type": "menu",
          "settings": {
            "title": "Resources"
          }
        },
        {
          "type": "menu",
          "settings": {
            "title": "Help & Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}