{{ 'faq-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top}}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}


<div
  class="faq-accordion  color-{{ section.settings.section_color_scheme }}"
  data-section-id="{{ section.id }}"
>

<div class="color-{{ section.settings.section_color_scheme }}">

    <div class="faq-accordion__container page-width section-{{ section.id }}-padding">
  
      {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="faq-accordion__header">
  
          {% if section.settings.heading != blank %}
            <h2 class="faq-accordion__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
  
          {% if section.settings.subheading != blank %}
            <div class="faq-accordion__subheading">
              {{ section.settings.subheading }}
            </div>
          {% endif %}
  
        </div>
      {% endif %}
  
  
      {% if section.blocks.size > 0 %}
        <faq-accordion class="faq-accordion__list">
  
          {% for block in section.blocks %}
  
            <div
              class="faq-accordion__item"
              {{ block.shopify_attributes }}
            >
  
              <button
                type="button"
                class="faq-accordion__question"
                aria-expanded="false"
                aria-controls="FAQAnswer-{{ section.id }}-{{ block.id }}"
              >
  
                <span class="faq-accordion__question-text">
                  {{ block.settings.question }}
                </span>
  
                <span
                  class="
                    faq-accordion__icon
                    faq-accordion__icon--{{ section.settings.icon_type }}
                  "
                  aria-hidden="true"
                >
                  {% if section.settings.icon_type == 'plus' %}
  
                    <span class="faq-accordion__plus">
                      <span class="faq-accordion__plus-horizontal"></span>
                      <span class="faq-accordion__plus-vertical"></span>
                    </span>
  
                  {% else %}
  
                    <span class="faq-accordion__arrow">
                     {% render 'icons' icon:'arrow-right', width: '25', height: '25' %}
                    </span>
  
                  {% endif %}
                </span>
  
              </button>
  
  
              <div
                id="FAQAnswer-{{ section.id }}-{{ block.id }}"
                class="faq-accordion__answer"
                role="region"
                aria-hidden="true"
              >
                <div class="faq-accordion__answer-inner">
  
                  {% if block.settings.answer != blank %}
                    <div class="faq-accordion__answer-content rte">
                      {{ block.settings.answer }}
                    </div>
                  {% endif %}
  
                </div>
              </div>
  
            </div>
  
          {% endfor %}
  
        </faq-accordion>
  
      {% else %}
  
       
  
      {% endif %}
  
    </div>
</div>
</div>


{% javascript %}

  if (!customElements.get('faq-accordion')) {
    class FaqAccordion extends HTMLElement {

      constructor() {
        super();

        this.items = this.querySelectorAll('.faq-accordion__item');
      }


      connectedCallback() {
        this.items.forEach((item) => {

          const button = item.querySelector('.faq-accordion__question');

          if (!button) return;

          button.addEventListener('click', () => {
            this.toggleItem(item);
          });

        });

      }


      toggleItem(item) {

        const button = item.querySelector('.faq-accordion__question');
        const answer = item.querySelector('.faq-accordion__answer');

        const isOpen = item.classList.contains('is-open');

        if (isOpen) {

          item.classList.remove('is-open');

          button.setAttribute('aria-expanded', 'false');
          answer.setAttribute('aria-hidden', 'true');

        } else {

          item.classList.add('is-open');

          button.setAttribute('aria-expanded', 'true');
          answer.setAttribute('aria-hidden', 'false');

        }

      }

    }

    customElements.define('faq-accordion', FaqAccordion);
  }

{% endjavascript %}


{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
    "type": "select",
    "id": "layout",
    "label": "Layout",
    "options": [
        {
            "label": "Full width",
            "value": "full-width"
        },
        {
            "label": "Page width",
            "value": "page-width"
        }
    ]
  },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
     {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        }
,
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Quick answers to the most common questions.</p>"
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Accordion icon",
      "options": [
        {
          "value": "plus",
          "label": "Plus / Minus"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        }
      ],
      "default": "plus"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],

  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does this work?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add the answer to this frequently asked question.</p>"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How does this work?"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Where does the money go?"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How are stories verified?"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is your shipping and return policy?"
          }
        }
       ]
    }
  ]
}
{% endschema %}