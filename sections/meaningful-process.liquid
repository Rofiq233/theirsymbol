{{ 'meaningful-bracelet.css' | asset_url | stylesheet_tag }}

<section id="meaningful-bracelet-{{ section.id }}" class="meaningful-bracelet-section">
  <div class="meaningful-bracelet__container">

    {% if section.settings.heading != blank %}
      <h2 class="meaningful-bracelet__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="meaningful-bracelet__subheading">{{ section.settings.subheading }}</div>
    {% endif %}

    {% assign card_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'card' %}
        {% assign card_count = card_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if section.blocks.size > 0 %}
      <div class="meaningful-bracelet__rows">

        {% comment %}
          TEXT BLOCK is kept separate from card counting.
          On desktop, with 1–3 cards, the text block occupies the next
          column, matching the screenshot (3 cards + text).
        {% endcomment %}

        {% assign card_index = 0 %}
        {% assign row_card_count = 0 %}
        {% assign row_number = 0 %}

        {% if card_count > 0 %}
          {% assign row_number = 1 %}

          <div class="meaningful-bracelet__row meaningful-bracelet__row--cards">
            {% for block in section.blocks %}
              {% if block.type == 'card' %}
                {% assign card_index = card_index | plus: 1 %}

                <article class="meaningful-bracelet__item" {{ block.shopify_attributes }}>
                  <div class="meaningful-bracelet__card">
                    {% if block.settings.image != blank %}
                      <div class="meaningful-bracelet__image-wrap image-ratio image-ratio--{{ block.settings.image_ratio }}">
                        {{
                          block.settings.image
                          | image_url: width: 1400
                          | image_tag:
                            loading: 'lazy',
                            widths: '320, 480, 640, 800, 1000, 1200, 1400',
                            sizes: '(min-width: 990px) calc((100vw - 120px) / 4), (min-width: 750px) calc((100vw - 48px) / 2), calc(100vw - 32px)',
                            class: 'meaningful-bracelet__image',
                            alt: block.settings.image.alt | escape
                        }}
                      </div>
                    {% endif %}

                    {% if block.settings.caption != blank %}
                      <div class="meaningful-bracelet__caption">{{ block.settings.caption }}</div>
                    {% endif %}
                  </div>

                  {% unless forloop.last %}
                    {% if card_index < 4 %}
                      <span class="meaningful-bracelet__arrow" aria-hidden="true">→</span>
                    {% endif %}
                  {% endunless %}
                </article>

                {% assign row_card_count = row_card_count | plus: 1 %}

                {% if row_card_count == 4 and card_index < card_count %}
                  </div>
                  <div class="meaningful-bracelet__row meaningful-bracelet__row--cards">
                  {% assign row_card_count = 0 %}
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% comment %}
          The text block is a real Shopify block.
          For the screenshot layout (3 cards + text), it is placed beside
          the cards on desktop. For more than 3 cards it becomes its own
          content row after the card rows.
        {% endcomment %}

        {% for block in section.blocks %}
          {% if block.type == 'text' %}
            <div class="meaningful-bracelet__text-block" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="meaningful-bracelet__text-title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="meaningful-bracelet__text-content">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Meaningful process",
  "tag": "section",
  "class": "meaningful-bracelet",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Their Symbol to Your Bracelet"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A real drawing. A meaningful design. A greater impact."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Process card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "1. Their original drawing"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image ratio",
          "default": "adapt",
          "options": [
            {
              "value": "adapt",
              "label": "Adapt to image"
            },
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            },
            {
              "value": "landscape",
              "label": "Landscape"
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "Text block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Meaningful jewelry"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We transform real drawings, phrases, or symbols into high-quality jewelry you can wear — a piece that carries meaning.</p>"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Meaningful process",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "caption": "1. Their original drawing"
          }
        },
        {
          "type": "card",
          "settings": {
            "caption": "2. Our design process"
          }
        },
        {
          "type": "card",
          "settings": {
            "caption": "3. A meaningful bracelet"
          }
        },
        {
          "type": "text",
          "settings": {
            "title": "",
            "text": "<p>We transform real drawings, phrases, or symbols into high-quality jewelry you can wear — a piece that carries meaning.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
